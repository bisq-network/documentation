---
import SavedWikiLink from "./SavedWikiLink.astro";
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { collectGuides, sections, loadIntegration } from "../../scripts/lib/documentation.mjs";
import { productEvidence } from "../../scripts/lib/product-evidence.mjs";
import notes from "../../migration/source-review-notes.json";
import { acceptedEditsFor, pullRequestLabel } from "../../scripts/lib/accepted-edits.mjs";
import { articlePageContent } from "../../scripts/lib/article-page.mjs";

const id = Astro.locals.starlightRoute.entry.id.replace(/\.(md|mdx)$/, "").replace(/(?:^|\/)index$/, "");
const route = id ? `/${id}/` : "/";
const article = loadIntegration().find((item) => item.target === route);
const checks = article ? notes.items.filter((note) => note.source_slugs.includes(article.slug)) : [];
const needsReview = checks.filter((note) => note.status === "needs-maintainer-review").length;
const guide = article ? collectGuides().find((item) => item.slug === article.slug) : undefined;
const topic = sections.find((section) => section.directory === guide?.directory)?.label;
const products = article ? productEvidence(article) : [];
// The page shows the rendered article after the string replacements in
// scripts/lib/article-page.mjs; the fidelity gate checks the same result.
const page = articlePageContent(await Astro.slots.render("default"), id, import.meta.env.BASE_URL);
const { links, templates } = page;
const unresolvedSections = page.sections.unresolved;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const date = (value: string) => new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(value));
const images = page.media.images;
const edits = article ? acceptedEditsFor(article.slug) : [];
---
{article && checks.length > 0 && <aside class="source-context" data-pagefind-ignore aria-label="Migration notes">
  <details class="source-checks" open={checks.some((note) => "display_priority" in note && note.display_priority === "prominent")}>
    <summary><strong>Migration notes ({checks.length})</strong>{needsReview > 0 && <span class="docs-chip review">{needsReview} needs maintainer review</span>}<span class="source-note-origin">Added during migration, not part of the original</span></summary>
    <p>These notes identify specific differences or review needs. They are not a review of the whole procedure.</p>
    {checks.map((note) => <section>
      <h2>{note.title}</h2>
      <span class:list={["docs-chip", { review: note.status === "needs-maintainer-review" }]}>{note.status === "needs-maintainer-review" ? "Needs maintainer review" : "Checked against pinned source"}</span>
      <p>{note.body}</p>
      <p class="source-check-date">Checked {date(note.checked_at)}</p>
      <ul>{note.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul>
    </section>)}
  </details>
</aside>}
{article && <>
  {topic && <span hidden data-pagefind-ignore data-pagefind-filter={`topic:${topic}`}></span>}
  {(products.length ? products : [{ label: "Product not stated" }]).map((product) => <span hidden data-pagefind-ignore data-pagefind-filter={`product:${product.label}`}></span>)}
</>}
<Default><Fragment set:html={page.content} /></Default>
{["browse", "browse/all"].includes(id) && <SavedWikiLink id="browse" />}
{article && <section class="source-history" data-pagefind-ignore aria-labelledby="docs-source-history">
  <h2 id="docs-source-history">Source and history</h2>
  <p>{edits.length
    ? `This article keeps its recovered headings and available images. Some wording was changed after restoration in the pull request${edits.length === 1 ? "" : "s"} listed below; the original wikitext keeps the earlier wording.`
    : "This article keeps its recovered wording, headings, step order and available images."} Formatting and links are adapted for this site. {article.recovery_note || "The snapshot does not guarantee that every instruction is current."}</p>
  <dl>
    <dt>Original page</dt><dd><a href={article.original_url}>{article.title}</a></dd>
    <dt>Revision</dt><dd><a href={article.original_revision_url}>{article.revision_id}</a> · {date(article.revision_timestamp)}</dd>
    <dt>Last recorded editor</dt><dd>{article.available_attribution?.username || "Not recorded"} <span class="source-note-origin">(not a complete author list)</span></dd>
    <dt>Snapshot</dt><dd>{article.snapshot_label || "18 October 2026"}</dd>
    {edits.length > 0 && <><dt>Edited after restoration</dt><dd><ul class="source-edits">{edits.map((edit) => <li>{date(edit.accepted_on)} · {edit.summary} · <a href={edit.pull_request}>{pullRequestLabel(edit.pull_request)}</a></li>)}</ul></dd></>}
    <dt>Source files</dt><dd><a href={`${base}${article.source_download}`}>Original wikitext</a> · <a href={`${base}${article.source_metadata}`}>Revision metadata</a></dd>
    {images.length > 0 && <><dt>Image references</dt><dd>{images.filter((image) => image.asset_path).length} recovered, {images.filter((image) => !image.asset_path).length} missing{images.some((image) => image.status === "partial") && ` (${images.filter((image) => image.status === "partial").length} recovered as thumbnails or partial files)`} · <a href={`${base}/recovered-media/`}>Media catalogue</a></dd></>}
    <dt>Recovery gaps</dt><dd>{templates.restored} restored historical template occurrences · {templates.unresolved} unresolved templates · {links.unresolved} unresolved article links · {unresolvedSections} unresolved sections</dd>
  </dl>
  <p><a href={`${base}/recovery-status/`}>Recovery scope and remaining source gaps</a></p>
</section>}
{article && <script type="application/json" id="article-media-data" set:html={JSON.stringify(images.map((image) => ({ id: image.element_id, status: image.status, width: image.width, height: image.height }))).replace(/</g, "\\u003c")} />}
<script src="../scripts/article-experience.ts"></script>
