---
import SavedWikiLink from "./SavedWikiLink.astro";
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { collectGuides, sections, loadIntegration } from "../../scripts/lib/documentation.mjs";
import { productEvidence } from "../../scripts/lib/product-evidence.mjs";
import notes from "../../migration/source-review-notes.json";

const id = Astro.locals.starlightRoute.entry.id.replace(/\.(md|mdx)$/, "").replace(/(?:^|\/)index$/, "");
const route = id ? `/${id}/` : "/";
const article = loadIntegration().find((item) => item.target === route);
const checks = article ? notes.items.filter((note) => note.source_slugs.includes(article.slug)) : [];
const guide = article ? collectGuides().find((item) => item.slug === article.slug) : undefined;
const topic = sections.find((section) => section.directory === guide?.directory)?.label;
const products = article ? productEvidence(article) : [];
const content = (await Astro.slots.render("default")).replace(
  /<details\b([^>]*\bclass="[^"]*\bwiki-table-source\b[^"]*"[^>]*)>/g,
  (tag, attributes) => attributes.includes("data-pagefind-ignore") ? tag : `<details${attributes} data-pagefind-ignore>`,
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
{article && (
  <aside class="source-context" data-pagefind-ignore aria-label="Article source">
    <p>Original wiki wording · recovered from the 18 October 2026 snapshot. <a href={`${base}/review/`}>Review status</a></p>
    {checks.length > 0 && <details class="source-checks">
      <summary>Separate source-check notes ({checks.length})</summary>
      <p>Added during migration; these notes are not part of the original article. They identify specific differences or review needs, not a review of the entire procedure.</p>
      {checks.map((note) => <section>
        <h2>{note.title}</h2>
        <p>{note.body}</p>
        <p class="source-check-date">Checked {note.checked_at}{note.status === "needs-maintainer-review" ? " · maintainer review needed" : " · pinned sources below"}</p>
        <ul>{note.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul>
      </section>)}
    </details>}
  </aside>
)}
{article && <>
  {topic && <span hidden data-pagefind-ignore data-pagefind-filter={`topic:${topic}`}></span>}
  {(products.length ? products : [{ label: "Product not stated" }]).map((product) => <span hidden data-pagefind-ignore data-pagefind-filter={`product:${product.label}`}></span>)}
</>}
<Default><Fragment set:html={content} /></Default>
{["browse", "browse/all"].includes(id) && <SavedWikiLink id="browse" />}
{article && (
  <details id="docs-source-history" class="source-history" data-pagefind-ignore>
    <summary>Source history and attribution</summary>
    <p>This article retains its recovered wording, headings, step order and available images. Formatting and links have been adapted for this site. The snapshot is not a guarantee that every instruction is current.</p>
    <p><strong>{article.title}</strong>: <a href={`${base}${article.source_download}`}>original wikitext</a> · <a href={`${base}${article.source_metadata}`}>revision metadata</a>
      {article.available_attribution?.username && <> · last recorded editor: {article.available_attribution.username}</>}
    </p>
    <p>The last recorded editor is not a complete author list. <a href={`${base}/recovery-status/`}>Recovery scope and remaining source gaps</a></p>
  </details>
)}
{article && <script type="application/json" id="article-media-data" set:html={JSON.stringify(article.image_occurrences.map((image) => ({ id: image.element_id, status: image.status, width: image.width, height: image.height }))).replace(/</g, "\\u003c")} />}
<script src="../scripts/article-experience.ts"></script>
