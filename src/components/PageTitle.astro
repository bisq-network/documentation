---
import Icon from "./Icon.astro";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import AboutPage from "./AboutPage.astro";
import SuggestEdit from "./SuggestEdit.astro";
import { collectGuides, loadIntegration, newArticles, sections } from "../../scripts/lib/documentation.mjs";
import { productEvidence } from "../../scripts/lib/product-evidence.mjs";
import { acceptedEditsFor, pullRequestLabel } from "../../scripts/lib/accepted-edits.mjs";
import notes from "../../migration/source-review-notes.json";

const id = Astro.locals.starlightRoute.entry.id.replace(/\.(md|mdx)$/, "");
const article = loadIntegration().find((item) => item.route === `/${id}/`);
// An article written after the recovery (src/data/new-articles.json) has no source revision.
const newArticle = article ? undefined : newArticles.find((item) => item.route === `/${id}/`);
const newSection = sections.find((item) => item.directory === newArticle?.directory);
const guide = article ? collectGuides().find((item) => item.slug === article.slug) : undefined;
const section = sections.find((item) => item.directory === guide?.directory);
const products = article ? productEvidence(article) : newArticle ? productEvidence(newArticle) : [];
const edits = article ? acceptedEditsFor(article.slug) : [];
const checks = article ? notes.items.filter((note) => note.source_slugs.includes(article.slug)).length : 0;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const revisionDate = article?.revision_timestamp ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(article.revision_timestamp)) : "Date not recorded";
---
{article ? <>
  <nav class="article-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol><li><a href={`${base}/`}>Docs</a></li>{section && <li><a href={`${base}/browse/${section.directory}/`}>{section.label}</a></li>}</ol>
  </nav>
  <h1 id="_top" lang={article.source_language || undefined}>{article.title}</h1>
  {/* The title block lines up with the reading column: where the wording comes from on the left,
      the page's actions on the right. */}
  <div class="article-title-context" data-pagefind-ignore>
    <div class="article-meta">
      <p class="article-meta-info">
        {/* A chip only where the article names a product; no chip is shown without that evidence. */}
        {products.map((product) => <span class="docs-chip product" title={product.basis}>{product.label}</span>)}
        {edits.length ? <span>Edited after restoration: {edits.map((edit, index) => <>{index > 0 && ", "}<a href={edit.pull_request}>{pullRequestLabel(edit.pull_request)}</a></>)}</span> : <span>Original wiki wording</span>}
        <span class="revision-stamp">rev {article.revision_id} · {revisionDate}</span>
      </p>
      <div class="article-meta-actions">
        <button type="button" class="docs-icon-button" data-copy-page hidden aria-label="Copy link to this page" title="Copy link to this page"><Icon name="link" size={18} /></button>
        <SuggestEdit />
      </div>
    </div>
    {/* Below 72rem the migration checks are a closed row here; from 72rem they are a card in the
        right rail (TableOfContents.astro). Articles without checks have neither. */}
    {checks > 0 && <details class="about-page about-page-row">
      <summary><Icon name="chevronRight" size={16} class="disclosure-icon" /><span class="about-page-row-title">About this page</span><span class="about-page-row-count">{checks} migration {checks === 1 ? "check" : "checks"}</span></summary>
      <AboutPage />
    </details>}
  </div>
</> : newArticle ? <>
  <nav class="article-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol><li><a href={`${base}/`}>Docs</a></li>{newSection && <li><a href={`${base}/browse/${newSection.directory}/`}>{newSection.label}</a></li>}</ol>
  </nav>
  <h1 id="_top">{newArticle.title}</h1>
  <div class="article-title-context" data-pagefind-ignore>
    {/* The same title row as a restored article: where the text comes from, then the actions. */}
    <div class="article-meta">
      <p class="article-meta-info">
        {products.map((product) => <span class="docs-chip product" title={product.basis}>{product.label}</span>)}
        <span>New article, not from the original wiki</span>
        <span class="revision-stamp">added {new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(`${newArticle.added}T00:00:00Z`))}</span>
      </p>
      <div class="article-meta-actions">
        <button type="button" class="docs-icon-button" data-copy-page hidden aria-label="Copy link to this page" title="Copy link to this page"><Icon name="link" size={18} /></button>
        <SuggestEdit />
      </div>
    </div>
  </div>
</> : <Default />}
