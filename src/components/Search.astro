---
import Default from "@astrojs/starlight/components/Search.astro";
---
<Default {...Astro.props} />
<script>
  // Starlight's search button has a visible shortcut hint; its accessible name says the same, so
  // the name contains what the button shows (WCAG 2.5.3). The rest of the site's search additions
  // load with the search interface (src/scripts/pagefind-ui-on-open.ts).
  document.querySelectorAll<HTMLButtonElement>("site-search button[data-open-modal]").forEach((button) => {
    const keys = [...button.querySelectorAll(":scope > kbd > kbd")].map((key) => key.textContent?.trim()).filter(Boolean).join(" ");
    if (keys) button.setAttribute("aria-label", `Search ${keys}`);
  });
</script>
