---
interface Props {
    id: string;
    initialValue?: string;
}
const { id, initialValue = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fieldId = `saved-wiki-link-${id}`;
---
<form
    class="saved-wiki-link"
    data-saved-wiki-link
    data-base={base}
    data-map-url={`${base}/saved-wiki-links.json`}
    data-site-origin={Astro.site?.origin}
    data-pagefind-ignore
    action={`${base}/browse/all/`}
    aria-label="Open a saved wiki link"
    novalidate
>
    <fieldset disabled>
        <label for={fieldId}>Open a saved wiki link</label>
        <div class="saved-link-row">
            <input id={fieldId} name="saved-link" type="text" inputmode="url"
                value={initialValue} autocomplete="off" spellcheck="false" maxlength="4096"
                placeholder="bisq.wiki/Last_resort_restore#Import_raw_data_from_backup"
                aria-describedby={`${fieldId}-help ${fieldId}-result`} />
            <button class="docs-button" type="submit">Find page</button>
        </div>
    </fieldset>
    <p id={`${fieldId}-help`} class="saved-link-help">Paste a wiki address or an earlier preview path.</p>
    <div id={`${fieldId}-result`} class="saved-link-result" data-saved-link-result role="status" aria-live="polite" aria-atomic="true"></div>
    <p class="saved-link-fallback"><a href={`${base}/browse/all/`}>Browse all article titles</a><noscript>. Link lookup needs JavaScript; the article directory works without it.</noscript></p>
</form>
<script>
    import "../scripts/saved-wiki-link.mjs";
</script>
<style>
    .saved-wiki-link { display: grid; gap: .5rem; max-width: 40rem; margin-block: 1.5rem; }
    fieldset { display: grid; gap: .5rem; border: 0; padding: 0; margin: 0; min-width: 0; }
    label { font-weight: 600; font-size: .9375rem; }
    .saved-link-row { display: flex; flex-wrap: wrap; gap: .5rem; }
    input { flex: 1 1 16rem; min-width: 0; width: 100%; min-height: 2.75rem; padding: .5rem .75rem; font: inherit; color: var(--sl-color-text); background: var(--bd-raised); border: 1px solid var(--bd-control-line); border-radius: 6px; }
    button { min-height: 2.75rem; font: inherit; }
    input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
    .saved-link-help, .saved-link-fallback { margin: 0; font-size: .875rem; }
    .saved-link-help { color: var(--sl-color-gray-2); }
    .saved-link-result { display: grid; gap: .35rem; overflow-wrap: anywhere; font-size: .9375rem; }
    .saved-link-result:not(:empty) { padding: .75rem 1rem; border: 1px solid var(--sl-color-hairline); border-radius: 6px; background: var(--bd-raised); }
    .saved-link-result[data-state="miss"] { border-color: var(--bd-warn-line); background: var(--bd-warn-bg); color: var(--bd-warn-ink); }
    .saved-link-result :global(a) { color: var(--sl-color-text-accent); text-decoration: underline; }
    .saved-link-result :global(a:focus-visible) { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
    .saved-link-result :global(p), .saved-link-result :global(ul) { margin: 0; }
    .saved-link-result :global(.saved-link-url) { font: .8125rem/1.5 var(--sl-font-mono); overflow-wrap: anywhere; }
    fieldset:disabled { opacity: .7; }
</style>
