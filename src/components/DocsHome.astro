---
import Icon from "./Icon.astro";
import type * as lucide from "../icons/lucide.mjs";
type IconName = keyof typeof lucide;
import SavedWikiLink from "./SavedWikiLink.astro";
import { sections } from "../../scripts/lib/documentation.mjs";
import { setupTasks, tryQueries, urgentTasks } from "../data/shortcuts.mjs";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const urgent = urgentTasks();
const setup = setupTasks();
const total = sections.reduce((sum, section) => sum + section.count, 0);
// Which Bisq: one row per product, each with the words that describe it and where they come from.
const products = [
  { route: "/wiki/bisq-2/", label: "Bisq 2", text: "“Bisq 2 is the successor to the original Bisq (Bisq v1).”", source: "From the article Bisq 2" },
  { route: "/wiki/bisq-1/", label: "Bisq 1", text: "The original Bisq desktop application, called “Bisq v1” in the Bisq 2 article.", source: "About Bisq 1" },
];
// One icon per topic, from the site's icon set (src/icons/lucide.mjs).
const icons: Record<string, IconName> = {
  start: "flag",
  trade: "arrowLeftRight",
  payments: "creditCard",
  wallet: "wallet",
  disputes: "scale",
  troubleshooting: "wrench",
  setup: "slidersHorizontal",
  dao: "landmark",
  contribute: "userPlus",
  reference: "bookOpen",
};
---
<div class="docs-home not-content">
  <section class="home-hero" aria-label="Search">
    <p class="home-lede">Guides for Bisq 1 and Bisq 2 from the Bisq wiki.</p>
    <button class="home-search-field" type="button" data-docs-search="" aria-haspopup="dialog" aria-keyshortcuts="Control+K"><Icon name="search" size={20} /><span>Search articles, sections, people…</span><kbd hidden><kbd>Ctrl</kbd><kbd>K</kbd></kbd></button>
    <script is:inline>
      // The shortcut hint names the reader's key, as the header search button does: ⌘ K on Apple
      // platforms, Ctrl K elsewhere (Starlight's Search.astro reads navigator.platform the same way).
      // It runs here, before the first paint, so the hint never changes after it shows.
      (() => {
        const field = document.currentScript?.previousElementSibling;
        const hint = field?.querySelector(":scope > kbd");
        if (!hint) return;
        if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
          hint.firstElementChild.textContent = "⌘";
          field.setAttribute("aria-keyshortcuts", "Meta+K");
        }
        hint.hidden = false;
      })();
    </script>
    <div class="home-try" data-pagefind-ignore data-search-controls><span>Try</span>{tryQueries.map((query) => <button type="button" data-docs-search={query}>{query}</button>)}</div>
    <noscript><p><a href={`${base}/browse/all/`}>Browse all article titles</a></p></noscript>
  </section>
  <div class="home-start">
    <section class="home-urgent" aria-labelledby="home-urgent">
      <h2 id="home-urgent"><Icon name="triangleAlert" size={20} />Something is wrong right now</h2>
      <ul class="home-rows">{urgent.map(({ label, guide }) => <li><a href={`${base}${guide.route}`}><span class="home-row-text"><span class="home-row-label">{label}</span><small>{guide.title}</small></span><Icon name="chevronRight" size={16} /></a></li>)}</ul>
    </section>
    <section class="home-setup" aria-labelledby="home-setup">
      <h2 id="home-setup">Set up and trade</h2>
      <ul class="home-rows">{setup.map(({ label, guide }) => <li><a href={`${base}${guide.route}`}><span class="home-row-text"><span class="home-row-label">{label}</span><small>{guide.title}</small></span><Icon name="chevronRight" size={16} /></a></li>)}</ul>
    </section>
    <section class="home-products" aria-labelledby="home-products">
      <h2 id="home-products">Which Bisq do you use?</h2>
      <ul class="home-rows">{products.map((product) => <li><a href={`${base}${product.route}`}><span class="home-row-text"><span class="home-row-label">{product.label}</span><span class="home-row-quote">{product.text}</span><small>{product.source}</small></span><Icon name="chevronRight" size={16} /></a></li>)}</ul>
    </section>
  </div>
  <section class="home-topics-section" aria-labelledby="home-topics">
    <div class="home-section-head"><h2 id="home-topics">Browse by topic</h2><a href={`${base}/browse/all/`}>All {total} articles</a></div>
    <ul class="home-topic-list">{sections.map((section) => <li><a href={`${base}/browse/${section.directory}/`}>
      <Icon name={icons[section.directory]} size={20} />
      <span class="home-row-text"><span class="home-row-label">{section.label}</span><small>{section.intro}</small></span>
      <span class="home-topic-count"><span class="sr-only">, </span>{section.count}<span class="sr-only"> articles</span></span>
    </a></li>)}</ul>
  </section>
  <section class="home-help" aria-labelledby="home-help">
    <h2 id="home-help">Old links and help</h2>
    <p><a href={`${base}/review/`}>Help improve this documentation</a> · <a href={`${base}/recovery-status/`}>Source recovery details</a> · <a href={`${base}/recovered-media/`}>Recovered media catalogue</a></p>
    <SavedWikiLink id="home" />
  </section>
</div>
<script src="../scripts/docs-discovery.ts"></script>
